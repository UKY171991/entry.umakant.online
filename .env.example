APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Email Transaction System Configuration
EMAIL_TRANSACTION_ADMIN_EMAILS="admin@example.com,tech@example.com"
EMAIL_TRANSACTION_MAX_RETRIES=3
EMAIL_TRANSACTION_RETRY_DELAY=5
EMAIL_TRANSACTION_EXPONENTIAL_BACKOFF=true
EMAIL_TRANSACTION_DUPLICATE_THRESHOLD=0.01
EMAIL_TRANSACTION_DUPLICATE_TIME_WINDOW=24
EMAIL_TRANSACTION_PARSING_FAILURE_THRESHOLD=0.3
EMAIL_TRANSACTION_CONNECTION_FAILURE_COOLDOWN=3600
EMAIL_TRANSACTION_CRITICAL_ERROR_COOLDOWN=3600
EMAIL_TRANSACTION_LOG_CHANNEL=email_transactions
EMAIL_TRANSACTION_LOG_LEVEL=info
EMAIL_TRANSACTION_AUDIT_TRAIL=true
EMAIL_TRANSACTION_PERFORMANCE_METRICS=true
EMAIL_TRANSACTION_SLOW_OPERATION_THRESHOLD=30
EMAIL_TRANSACTION_MEMORY_THRESHOLD=128
EMAIL_TRANSACTION_ENABLE_METRICS=true
EMAIL_TRANSACTION_FAILED_RETENTION_DAYS=30
EMAIL_TRANSACTION_PROCESSED_RETENTION_DAYS=365
EMAIL_TRANSACTION_LOG_RETENTION_DAYS=90
EMAIL_TRANSACTION_ENCRYPT_CONTENT=false
EMAIL_TRANSACTION_MASK_SENSITIVE_DATA=true
EMAIL_TRANSACTION_REQUIRE_ADMIN_APPROVAL=false
EMAIL_TRANSACTION_BATCH_SIZE=50
EMAIL_TRANSACTION_PROCESSING_TIMEOUT=300
EMAIL_TRANSACTION_PARALLEL_PROCESSING=false
EMAIL_TRANSACTION_QUEUE_CONNECTION=default
EMAIL_TRANSACTION_QUEUE_NAME=email-transactions
EMAIL_TRANSACTION_ENABLE_HEALTH_CHECKS=true
EMAIL_TRANSACTION_HEALTH_CHECK_INTERVAL=300
EMAIL_TRANSACTION_CONNECTION_TIMEOUT=30
EMAIL_TRANSACTION_MAX_CONSECUTIVE_FAILURES=5
